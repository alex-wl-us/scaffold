{
	auto_https off
	admin off
	persist_config off
}

:8080 {
	handle /api/* {
		reverse_proxy {$API_UPSTREAM}
	}
	handle {
		root * /srv
		encode gzip
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
